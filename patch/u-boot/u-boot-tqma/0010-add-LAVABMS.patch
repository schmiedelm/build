diff --git a/board/tq/tqma93xx/tqma93xx-lavabms.c b/board/tq/tqma93xx/tqma93xx-lavabms.c
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/board/tq/tqma93xx/tqma93xx-lavabms.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Copyright (c) 2026 TQ-Systems GmbH <u-boot@ew.tq-group.com>,
+ * D-82229 Seefeld, Germany.
+ */
+
+#include <i2c.h>
+#include <usb.h>
+#include <asm/io.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/sys_proto.h>
+#include <asm/arch-imx9/ccm_regs.h>
+#if CONFIG_IS_ENABLED(IMX91)
+#include <asm/arch-imx9/imx91_pins.h>
+#elif CONFIG_IS_ENABLED(IMX93)
+#include <asm/arch-imx9/imx93_pins.h>
+#endif
+#include <asm/mach-imx/iomux-v3.h>
+#include <asm-generic/gpio.h>
+
+#include "../common/tq_bb.h"
+#include "../common/tq_som_features.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define UART_PAD_CTRL	(PAD_CTL_DSE(6) | PAD_CTL_FSEL2)
+
+/* console on LPUART3 (GPIO_IO14/GPIO_IO15) instead of the usual LPUART1 */
+static const iomux_v3_cfg_t uart_pads[] = {
+#if CONFIG_IS_ENABLED(MX91)
+	MX91_PAD_GPIO_IO14__LPUART3_TX | MUX_PAD_CTRL(UART_PAD_CTRL),
+	MX91_PAD_GPIO_IO15__LPUART3_RX | MUX_PAD_CTRL(UART_PAD_CTRL),
+#elif CONFIG_IS_ENABLED(MX93)
+	MX93_PAD_GPIO_IO14__LPUART3_TX | MUX_PAD_CTRL(UART_PAD_CTRL),
+	MX93_PAD_GPIO_IO15__LPUART3_RX | MUX_PAD_CTRL(UART_PAD_CTRL),
+#endif
+};
+
+/*
+ * NOTE: this is also used by SPL
+ */
+int tq_bb_board_early_init_f(void)
+{
+	init_uart_clk(LPUART3_CLK_ROOT);
+	imx_iomux_v3_setup_multiple_pads(uart_pads, ARRAY_SIZE(uart_pads));
+
+	return 0;
+}
+
+#if !defined(CONFIG_SPL_BUILD)
+
+const char *tq_bb_get_boardname(void)
+{
+	return "LAVA-BMS";
+}
+
+/*
+ * SD0 -> mmc0 / mmcblk0
+ * SD1 -> mmc1 / mmcblk1
+ */
+int board_mmc_get_env_dev(int devno)
+{
+	return devno;
+}
+
+/*
+ * we use dt alias based indexing, so kernel uses same index. See above
+ */
+int mmc_map_to_kernel_blk(int devno)
+{
+	return devno;
+}
+
+#if CONFIG_IS_ENABLED(USB)
+
+/*
+ * Neither USB port has a TCPC: USB1 is a plain connector used for the
+ * i.MX ROM serial downloader, USB2 only carries D+/D-/VBUS (ID is left
+ * on a test point). Both are fixed peripheral-mode ports.
+ */
+int board_usb_init(int index, enum usb_init_type init)
+{
+	if (init != USB_INIT_DEVICE)
+		return -ENODEV;
+
+	return 0;
+}
+
+int board_usb_cleanup(int index, enum usb_init_type init)
+{
+	return 0;
+}
+
+#endif /* USB */
+
+#if CONFIG_IS_ENABLED(DWC_ETH_QOS)
+
+/*
+ * DP83825IRMQ on ENET1 (RMII). The PHY is RMII clock master (own 25 MHz
+ * crystal, REF_CLK into ENET1_TD2), so the SOC side only needs its MAC
+ * clock domain configured - RGMII/RMII/MII interface selection in
+ * BLK_CTRL_WAKEUPMIX is handled automatically by the EQOS driver based
+ * on the "rmii" phy-mode in the device tree (board_interface_eth_init()).
+ */
+static int setup_eqos(void)
+{
+	return set_clk_eqos(ENET_50MHZ);
+}
+
+#endif /* DWC_ETH_QOS */
+
+int tq_bb_board_init(void)
+{
+	if (CONFIG_IS_ENABLED(DWC_ETH_QOS))
+		setup_eqos();
+
+	return 0;
+}
+
+int tq_bb_board_late_init(void)
+{
+	if (CONFIG_IS_ENABLED(ENV_IS_IN_MMC))
+		board_late_mmc_env_init();
+
+	tq_set_boot_targets();
+
+	return 0;
+}
+
+#if CONFIG_IS_ENABLED(OF_BOARD_SETUP)
+
+int tq_bb_ft_board_setup(void *blob, struct bd_info *bis)
+{
+	const struct tq_som_feature_list *features = tq_board_detect_features();
+
+	if (!features) {
+		pr_warn("WARN: tq_board_detect_features failed\n");
+		return -ENODATA;
+	}
+
+	tq_ft_fixup_features(blob, features);
+
+	return 0;
+}
+#endif
+
+#endif /* !CONFIG_SPL_BUILD */
