From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Schmiedel <Martin.Schmiedel@tq-group.com>
Date: Sat, 14 Nov 2026 23:13:31 +0100
Subject: [PATCH] drm/bridge: dw-hdmi: set CEC physical address with bridge
 connector

With DRM_BRIDGE_ATTACH_NO_CONNECTOR, dw-hdmi creates no connector and
registers no CEC notifier. The CEC adapter keeps physical address
f.f.f.f and claims no logical address.

Register the CEC notifier in the NO_CONNECTOR attach path. Set the
physical address from the EDID in the bridge edid_read callback.

After a hotplug, a DRM master that does not probe again leaves the
address invalid. Read the EDID from hpd_notify in a delayed work and
set the address again. Invalidate it on disconnect.

Seen on i.MX8MP (imx-lcdif + imx8mp-hdmi-tx): cec-ctl showed
"Physical Address: f.f.f.f" and an empty topology. With Kodi as DRM
master, the address stayed invalid after a TV input switch.

Signed-off-by: Martin Schmiedel <Martin.Schmiedel@tq-group.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 71 ++++++++++++++++++++++-
 1 file changed, 69 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index 34c5f58..0bc1db1 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -22,6 +22,7 @@
 #include <linux/regmap.h>
 #include <linux/dma-mapping.h>
 #include <linux/spinlock.h>
+#include <linux/workqueue.h>
 
 #include <media/cec-notifier.h>
 
@@ -192,6 +193,8 @@ struct dw_hdmi {
 
 	struct mutex cec_notifier_mutex;
 	struct cec_notifier *cec_notifier;
+	struct delayed_work cec_pa_work;
+	struct drm_connector *cec_connector;
 
 	hdmi_codec_plugged_cb plugged_cb;
 	struct device *codec_dev;
@@ -2926,7 +2929,21 @@ static int dw_hdmi_bridge_attach(struct drm_bridge *bridge,
 		if (!next_bridge)
 			return -EPROBE_DEFER;
 
-		return drm_bridge_attach(encoder, next_bridge, bridge, flags);
+		int ret = drm_bridge_attach(encoder, next_bridge, bridge, flags);
+		if (ret)
+			return ret;
+
+		/* No own connector: register the CEC notifier here. */
+		struct cec_notifier *notifier =
+			cec_notifier_conn_register(hdmi->dev, NULL, NULL);
+		if (!notifier)
+			return -ENOMEM;
+
+		mutex_lock(&hdmi->cec_notifier_mutex);
+		hdmi->cec_notifier = notifier;
+		mutex_unlock(&hdmi->cec_notifier_mutex);
+
+		return 0;
 	}
 
 	return dw_hdmi_connector_create(hdmi);
@@ -2936,6 +2953,8 @@ static void dw_hdmi_bridge_detach(struct drm_bridge *bridge)
 {
 	struct dw_hdmi *hdmi = bridge->driver_private;
 
+	cancel_delayed_work_sync(&hdmi->cec_pa_work);
+
 	mutex_lock(&hdmi->cec_notifier_mutex);
 	cec_notifier_conn_unregister(hdmi->cec_notifier);
 	hdmi->cec_notifier = NULL;
@@ -3016,12 +3035,58 @@ dw_hdmi_bridge_detect(struct drm_bridge *bridge, struct drm_connector *connector
 	return dw_hdmi_detect(hdmi);
 }
 
+static void dw_hdmi_cec_set_phys_addr(struct dw_hdmi *hdmi,
+				      const struct drm_edid *drm_edid)
+{
+	mutex_lock(&hdmi->cec_notifier_mutex);
+	cec_notifier_set_phys_addr_from_edid(hdmi->cec_notifier,
+					     drm_edid ? drm_edid_raw(drm_edid) : NULL);
+	mutex_unlock(&hdmi->cec_notifier_mutex);
+}
+
 static const struct drm_edid *dw_hdmi_bridge_edid_read(struct drm_bridge *bridge,
 						       struct drm_connector *connector)
 {
 	struct dw_hdmi *hdmi = bridge->driver_private;
+	const struct drm_edid *drm_edid;
+
+	drm_edid = dw_hdmi_edid_read(hdmi, connector);
+	dw_hdmi_cec_set_phys_addr(hdmi, drm_edid);
+
+	return drm_edid;
+}
+
+/*
+ * After a hotplug nobody may read the EDID (e.g. a DRM master that does not
+ * probe again). Read it here, so CEC gets its physical address back.
+ */
+static void dw_hdmi_cec_pa_work(struct work_struct *work)
+{
+	struct dw_hdmi *hdmi = container_of(to_delayed_work(work),
+					    struct dw_hdmi, cec_pa_work);
+	const struct drm_edid *drm_edid;
+
+	drm_edid = dw_hdmi_edid_read(hdmi, hdmi->cec_connector);
+	dw_hdmi_cec_set_phys_addr(hdmi, drm_edid);
+	drm_edid_free(drm_edid);
+}
+
+static void dw_hdmi_bridge_hpd_notify(struct drm_bridge *bridge,
+				      struct drm_connector *connector,
+				      enum drm_connector_status status)
+{
+	struct dw_hdmi *hdmi = bridge->driver_private;
 
-	return dw_hdmi_edid_read(hdmi, connector);
+	if (status == connector_status_connected) {
+		hdmi->cec_connector = connector;
+		mod_delayed_work(system_wq, &hdmi->cec_pa_work,
+				 msecs_to_jiffies(100));
+	} else if (status == connector_status_disconnected) {
+		cancel_delayed_work(&hdmi->cec_pa_work);
+		mutex_lock(&hdmi->cec_notifier_mutex);
+		cec_notifier_phys_addr_invalidate(hdmi->cec_notifier);
+		mutex_unlock(&hdmi->cec_notifier_mutex);
+	}
 }
 
 static const struct drm_bridge_funcs dw_hdmi_bridge_funcs = {
@@ -3039,6 +3104,7 @@ static const struct drm_bridge_funcs dw_hdmi_bridge_funcs = {
 	.mode_valid = dw_hdmi_bridge_mode_valid,
 	.detect = dw_hdmi_bridge_detect,
 	.edid_read = dw_hdmi_bridge_edid_read,
+	.hpd_notify = dw_hdmi_bridge_hpd_notify,
 };
 
 /* -----------------------------------------------------------------------------
@@ -3360,6 +3426,7 @@ struct dw_hdmi *dw_hdmi_probe(struct platform_device *pdev,
 	mutex_init(&hdmi->mutex);
 	mutex_init(&hdmi->audio_mutex);
 	mutex_init(&hdmi->cec_notifier_mutex);
+	INIT_DELAYED_WORK(&hdmi->cec_pa_work, dw_hdmi_cec_pa_work);
 	spin_lock_init(&hdmi->audio_lock);
 
 	ddc_node = of_parse_phandle(np, "ddc-i2c-bus", 0);
